# ===========================================
# WebDevStudioHQ Production Environment
# ===========================================
# Copy this file to .env.local and fill in your values

# -------------------------------------------
# Site Configuration
# -------------------------------------------
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_SITE_NAME=Bulgarian Properties

# -------------------------------------------
# Contact Information (TODO: Replace with client contact details)
# -------------------------------------------
NEXT_PUBLIC_CONTACT_EMAIL=info@bulgarianproperties.com
NEXT_PUBLIC_CONTACT_PHONE=+359 888 123 456
NEXT_PUBLIC_CONTACT_ADDRESS=123 Vitosha Boulevard, Sofia 1000, Bulgaria
NEXT_PUBLIC_BUSINESS_NAME=Bulgarian Properties Ltd.

# -------------------------------------------
# Social Media Links (TODO: Replace with client social links)
# -------------------------------------------
NEXT_PUBLIC_SOCIAL_FACEBOOK=https://facebook.com/bulgarianproperties
NEXT_PUBLIC_SOCIAL_INSTAGRAM=https://instagram.com/bulgarianproperties
NEXT_PUBLIC_SOCIAL_LINKEDIN=https://linkedin.com/company/bulgarianproperties
NEXT_PUBLIC_SOCIAL_TWITTER=https://twitter.com/bgproperties

# -------------------------------------------
# Google Analytics 4
# -------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# -------------------------------------------
# Contact Form Integration
# -------------------------------------------
# For Formspree (https://formspree.io)
NEXT_PUBLIC_FORMSPREE_FORM_ID=your-form-id

# For custom API endpoint
NEXT_PUBLIC_API_URL=/api/contact

# -------------------------------------------
# Email Service (Server-side only)
# -------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-smtp-password
EMAIL_FROM=noreply@your-domain.com
EMAIL_TO=contact@your-domain.com

# -------------------------------------------
# Security
# -------------------------------------------
# Generate a secure random string: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-here

# -------------------------------------------
# Rate Limiting
# -------------------------------------------
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# -------------------------------------------
# External API Keys (Server-side only)
# -------------------------------------------
# For property data feeds
PROPERTY_API_KEY=your-property-api-key
PROPERTY_API_URL=https://api.propertydata.com

# For maps integration
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# -------------------------------------------
# CRM Integration (Optional)
# -------------------------------------------
CRM_API_KEY=your-crm-api-key
CRM_API_URL=https://api.crm-provider.com

# -------------------------------------------
# Stripe Integration (Optional)
# -------------------------------------------
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# -------------------------------------------
# Feature Flags
# -------------------------------------------
NEXT_PUBLIC_ENABLE_NEWSLETTER=true
NEXT_PUBLIC_ENABLE_PROPERTY_ALERTS=true
NEXT_PUBLIC_ENABLE_VIRTUAL_TOURS=false
